// Check puzzle status

script heatranPuzzleCall {
    if (flag(FLAG_WRONG_BUTTON_HEATRAN) && var(VAR_MTMORTAR_DEPTHS_HEATRAN_BUTTONS) == 6) {
        goto(heatranPuzzleReset)
    }
    if (var(VAR_MTMORTAR_DEPTHS_HEATRAN_BUTTONS) == 6) {
        setflag(FLAG_MTMORTAR_DEPTHS_HEATRANPUZZLED)
        playse(SE_BANG)
        setmetatile(40, 1, 0x414, FALSE)
        setmetatile(40, 0, 0x40C, FALSE)
        setvar(VAR_TEMP_E, 1)
        special(DrawWholeMapView)
    }
    return
}

// Reset the puzzle

script heatranPuzzleReset {
    setvar(VAR_MTMORTAR_DEPTHS_HEATRAN_BUTTONS, 0)
    clearflag(FLAG_WRONG_BUTTON_HEATRAN)
    clearflag(FLAG_TEMP_1)
    clearflag(FLAG_TEMP_2)
    clearflag(FLAG_TEMP_3)
    clearflag(FLAG_TEMP_4)
    clearflag(FLAG_TEMP_5)
    clearflag(FLAG_TEMP_6)
    clearflag(FLAG_TEMP_7)
    clearflag(FLAG_TEMP_8)
    clearflag(FLAG_TEMP_9)
    clearflag(FLAG_TEMP_A)
    playse(SE_FAILURE)
    waitse
    setmetatileinrange(38, 4, 42, 4, 0x4E3)
    setmetatileinrange(38, 6, 42, 6, 0x4E3)
    playse(SE_NOT_EFFECTIVE)
    special(DrawWholeMapView)
    release
    end
}

// Puzzle end

script heatranPuzzleHint {
    msgbox("Face of the heat,
            wielder of the magma storm.", MSGBOX_SIGN)
}

script MtMortarDepthsHeatran {
    lock
    faceplayer
    bosslegendaryencounter(SPECIES_HEATRAN, 70, 1, FLAG_HIDE_HEATRAN, 4, SPECIES_NONE, 110)
    release
    end
}
