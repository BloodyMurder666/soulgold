mapscripts MtMortar_Depths_1_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        if (flag(FLAG_MTMORTAR_DEPTHS_PUZZLE1SOLVED)) {
            setmetatile(20, 18, 0x404, FALSE)
            setmetatile(20, 19, 0x404, FALSE)
            setmetatile(20, 20, 0x404, FALSE)
        }
        if (flag(FLAG_MTMORTAR_DEPTHS_HEATRANPUZZLED)) {
            setmetatile(40, 1, 0x414, FALSE)
            setmetatile(40, 0, 0x40C, FALSE)

            setmetatile(40, 4, 0x4F3, FALSE)
            setmetatile(38, 6, 0x4F3, FALSE)
            setmetatile(39, 6, 0x4F3, FALSE)
            setmetatile(40, 6, 0x4F3, FALSE)
            setmetatile(41, 6, 0x4F3, FALSE)
            setmetatile(42, 6, 0x4F3, FALSE)
            setvar(VAR_TEMP_E, 1)
        }
    }
}

// Firetite puzzle

script firetitePuzzleButton1 {
    lock
    addvar(VAR_TEMP_A, 1)
    playse(SE_PIN)
    setmetatile(27, 14, 0x4E5, FALSE)
    special(DrawWholeMapView)
    call(firetitePuzzleCall)
    addvar(VAR_TEMP_0, 1)
    release
    end
}
script firetitePuzzleButton2 {
    lock
    addvar(VAR_TEMP_A, 1)
    playse(SE_PIN)
    setmetatile(12, 11, 0x4E5, FALSE)
    special(DrawWholeMapView)
    call(firetitePuzzleCall)
    addvar(VAR_TEMP_1, 1)
    release
    end
}
script firetitePuzzleButton3 {
    lock
    addvar(VAR_TEMP_A, 1)
    playse(SE_PIN)
    setmetatile(23, 34, 0x4E6, FALSE)
    special(DrawWholeMapView)
    call(firetitePuzzleCall)
    addvar(VAR_TEMP_2, 1)
    release
    end
}

script firetitePuzzleCall {
    if (var(VAR_TEMP_A) >= 3) {
        playse(SE_CLICK)
        delay(30)
        setmetatile(20, 18, 0x404, FALSE)
        setmetatile(20, 19, 0x404, FALSE)
        setmetatile(20, 20, 0x404, FALSE)
        setflag(FLAG_MTMORTAR_DEPTHS_PUZZLE1SOLVED)
        special(DrawWholeMapView)
    }
    return
}


//Heatran Puzzle


// Correct Buttons

script heatranPuzzleButtonCorrect1 {
    if (flag(FLAG_TEMP_3)) {
        release
        end
    }
    lock
    setflag(FLAG_TEMP_3)
    playse(SE_PIN)
    setmetatile(40, 4, 0x4F3, FALSE)
    special(DrawWholeMapView)
    addvar(VAR_MTMORTAR_DEPTHS_HEATRAN_BUTTONS, 1)
    call(heatranPuzzleCall)
    release
    end
}
