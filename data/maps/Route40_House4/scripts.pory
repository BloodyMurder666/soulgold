    msgbox("Amazing! 
    
            You've achieved {STR_VAR_1}
            things and reached my final
            milestone!
            
            These items are the only thing
            left to give. I have nothing
            further for you!")
    setvar(VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_MAGEARNA_ORIGINAL)
    bufferspeciesname(STR_VAR_1, SPECIES_MAGEARNA_ORIGINAL)
    givemon(SPECIES_MAGEARNA_ORIGINAL, 80)
    showgivemonpic(10, 3)
