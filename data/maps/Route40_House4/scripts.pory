mapscripts Route40_House4_MapScripts {}

const VAR_ACHIEVEMENT_COUNT = VAR_TEMP_0
const VAR_NEXT_ACHIEVEMENT_MILESTONE = VAR_TEMP_1
const VAR_ACHIEVEMENTS_REMAINING = VAR_TEMP_2

script AchievementGuy {
    lock
    faceplayer

    msgbox("I've achieved many things in my life.
            Now, I want to see what the younger
            generation can do.
            
            Let me have a closer look at you...")

    special(GetCompletedAchievementsCount)
    copyvar(VAR_ACHIEVEMENT_COUNT, VAR_RESULT)
    buffernumberstring(STR_VAR_1, VAR_ACHIEVEMENT_COUNT)

    if (var(VAR_ACHIEVEMENT_REWARD_MILESTONE) < 15
        && var(VAR_ACHIEVEMENT_COUNT) >= 15) {
        goto(AchievementGuy_Reward15)
    }
    if (var(VAR_ACHIEVEMENT_REWARD_MILESTONE) < 30
        && var(VAR_ACHIEVEMENT_COUNT) >= 30) {
        goto(AchievementGuy_Reward30)
    }
    if (var(VAR_ACHIEVEMENT_REWARD_MILESTONE) < 45
        && var(VAR_ACHIEVEMENT_COUNT) >= 45) {
        goto(AchievementGuy_Reward45)
    }
    if (var(VAR_ACHIEVEMENT_REWARD_MILESTONE) < 60
        && var(VAR_ACHIEVEMENT_COUNT) >= 60) {
        goto(AchievementGuy_Reward60)
    }
    if (var(VAR_ACHIEVEMENT_REWARD_MILESTONE) < 75
        && var(VAR_ACHIEVEMENT_COUNT) >= 75) {
        goto(AchievementGuy_Reward75)
    }
    if (var(VAR_ACHIEVEMENT_REWARD_MILESTONE) < 100
        && var(VAR_ACHIEVEMENT_COUNT) >= 100) {
        goto(AchievementGuy_Reward100)
    }

    if (var(VAR_ACHIEVEMENT_COUNT) >= 100) {
        msgbox("You've achieved everything possible!
                There is nothing further I could bestow
                upon you, true master of Pokémon.")
        release
        end
    }

    setvar(VAR_NEXT_ACHIEVEMENT_MILESTONE, 15)
    if (var(VAR_ACHIEVEMENT_COUNT) >= 15) {
        setvar(VAR_NEXT_ACHIEVEMENT_MILESTONE, 30)
    }
    if (var(VAR_ACHIEVEMENT_COUNT) >= 30) {
        setvar(VAR_NEXT_ACHIEVEMENT_MILESTONE, 45)
    }
    if (var(VAR_ACHIEVEMENT_COUNT) >= 45) {
        setvar(VAR_NEXT_ACHIEVEMENT_MILESTONE, 60)
    }
    if (var(VAR_ACHIEVEMENT_COUNT) >= 60) {
        setvar(VAR_NEXT_ACHIEVEMENT_MILESTONE, 75)
    }
    if (var(VAR_ACHIEVEMENT_COUNT) >= 75) {
        setvar(VAR_NEXT_ACHIEVEMENT_MILESTONE, 100)
    }

    copyvar(VAR_ACHIEVEMENTS_REMAINING, VAR_NEXT_ACHIEVEMENT_MILESTONE)
    subvar(VAR_ACHIEVEMENTS_REMAINING, VAR_ACHIEVEMENT_COUNT)
    buffernumberstring(STR_VAR_2, VAR_ACHIEVEMENTS_REMAINING)
    msgbox("Hmm... 
            You've achieved {STR_VAR_1} things 
            so far!
            
            If you were to achieve {STR_VAR_2} more
            things, I might have something for you!")
    release
    end

}

script keepUpTheGoodWork {
    createfieldmugshot(MUGSHOT_GENTLEMAN)
    msgbox("Never stop reaching for greater
            heights. I look forward to
            seeing what you will do next.")
    release
    end
}

script AchievementGuy_Reward15 {
    msgbox("Hmm! 
    
            You have at least {STR_VAR_1} 
            achievements under your belt! 
            
            A great start! I will bestow you this
            as a reward!")
    giveitem(ITEM_SHIN_GENOME)
    setvar(VAR_ACHIEVEMENT_REWARD_MILESTONE, 15)
    goto(keepUpTheGoodWork)
    release
    end
}

script AchievementGuy_Reward30 {
    msgbox("Excellent! 
    
            You've achieved {STR_VAR_1}
            things and reached the next step
            on your journey! 
            
            I have something nice for you!")
    setvar(VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_GRENINJA_BOND)
    bufferspeciesname(STR_VAR_1, SPECIES_GRENINJA_BOND)
    givemon(SPECIES_GRENINJA_BOND, 36)
    showgivemonpic(10, 3)
    call(Common_EventScript_GiftMon)
    hidemonpic
    setvar(VAR_ACHIEVEMENT_REWARD_MILESTONE, 30)
    goto(keepUpTheGoodWork)
    release
    end
}

