mapscripts GoldenrodApartment_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        if (flag(FLAG_MAGERNA_DOOR_OPENED)) {
            setmetatile(62, 8, 0x401, FALSE)
        }
    }
}

script GoldenrodApartments_BasementGuard {
    msgbox("Sorry but this stairway leads to the
            apartments storage. Besides, I don't
            think there's any reason why a trainer
            would want to check out old house
            appliances that have been abandoned
            due to rampant consumerism.")
    checkspecies(SPECIES_ROTOM)
    if (var(VAR_RESULT) == FALSE) {
        release
        end
    }
    msgbox("...What? You have a Rotom that wants
            check out the appliances? Well... 
            I suppose the tenants wouldn't
            use them anyway. Let's say I never
            saw you if anyone asks. I'm going to
            have a coffee break.")
    closemessage
    setflag(FLAG_HIDE_GROD_APARTMENTS_GUARD)
    fadescreenswapbuffers(FADE_TO_BLACK)
    removeobject(LOCALID_APARTMENT_GUARD)
    delay(60)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    release
    end
} 

script GoldenrodApartments_OldLady {
    msgbox("The city has been expanding a lot in
            recent years. I fear I've been left
            behind by the rapid changes.", MSGBOX_NPC)
}

script GoldenrodApartments_Child {
    msgbox("Mom always comes home late...", MSGBOX_NPC)
}

script GoldenrodApartments_Girl {
    msgbox("Our mother works at the radio tower,
            which makes her very busy. Luckily
            we have mom's Breloom to help with
            everything!", MSGBOX_NPC)
}

script GoldenrodApartments_Breloom {
    lock
    playmoncry(SPECIES_BRELOOM, CRY_MODE_NORMAL)
    waitmoncry
    msgbox("Breloom is joyfully doing the dishes!")
    waitmessage
    release
    end
}

script GoldenrodApartments_Gameboykid {
    msgbox("Strange noises can be heard from the
            floor above this. I have never seen
            anyone who lives there though, strange.", MSGBOX_NPC)
}

script GoldenrodApartments_ScientistF {
    msgbox("Goldenrod recently invited scientists
            from other regions to the Radio Tower
            for a business meeting.", MSGBOX_NPC)
}

script GoldenrodApartments_ScientistM {
    msgbox("These SkyBNB apartments are barely
            equipped with the most basics of
            tools... How vexing.", MSGBOX_NPC)
}

script GoldenrodApartments_LockedDoor {
    lock
    if (flag(FLAG_MAGERNA_DOOR_OPENED)) {
        msgbox("The door is now open.")
        release
        end
    }
    if (flag(FLAG_GOT_MAGERNA_KEY)) {
        msgbox("The way seems to be barred by a metal
            door. A small keyhole is visible. 
            
            You used the Apartment Key.")
        closemessage
        playse(SE_UNLOCK)
        setmetatile(62, 8, 0x401, FALSE)
        special(DrawWholeMapView)
        setflag(FLAG_MAGERNA_DOOR_OPENED)
        waitse
        setflag(FLAG_HIDE_MAGERNA_POLICE)
        removeobject(LOCALID_M_POLICE1)
        removeobject(LOCALID_M_POLICE2)
        msgbox("The way is now open.")
        release
        end
    }
    msgbox("The way seems to be barred by a metal
            door. A small keyhole is visible, but
            you have nothing that would fit it.")
    release
    end
}

