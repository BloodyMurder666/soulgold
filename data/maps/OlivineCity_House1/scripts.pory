raw `
OlivineCity_House1_MapScripts::
	.byte 0


`

script Olivine_VoltorbTrade {
    lock
    faceplayer
    if (flag(FLAG_OLIVINE_NPC_TRADE_COMPLETED)) {
        msgbox("Hi, how is my old Voltorb doing?")
    } else {
        ingame_trade(INGAME_TRADE_VOLTORB, "I collect Pokémon
                                         Do you have a Mareanie?
                                         Want to trade it for my
                                         Hisuian Voltorb?", 
                                         VoltorbTrade_Declined,
                                         VoltorbTrade_NotRequested,
                                         "Yay! I got myself a Mareanie!
                                        Voltorb, you take care!")
        setflag(FLAG_OLIVINE_NPC_TRADE_COMPLETED)
    }
    release
    end
}

script VoltorbTrade_Declined {
    msgbox("You don't want to trade? Aww...")
    release
    end                                 
}

script VoltorbTrade_NotRequested {
    msgbox("Uh, no, I don't think so.
            That doesn't look like a Mareanie.")
    release
    end
}