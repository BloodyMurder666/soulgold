mapscripts GoldenrodApartmentBasement_MapScripts {}

script RotomMachine_Wash {
    lock
    checkspecies(SPECIES_ROTOM, OPEN_PARTY_SCREEN)
    
    if (var(VAR_RESULT) == TRUE) {
        setvar(VAR_0x8000, 0)
        special(ChangeRotomForm)
        msgbox("Rotom form was changed!")
    }
    release
    end
}

