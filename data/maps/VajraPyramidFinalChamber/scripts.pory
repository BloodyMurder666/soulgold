mapscripts VajraPyramidFinalChamber_MapScripts {}

script FinalChamber_HoopaPrison {
    lock
    if (flag(FLAG_CAUGHT_HOOPA)) {
        msgbox("The contraption is empty.")
        release
        end
    }
    msgbox("Something seems to be sealed inside
            this contraption. Release it?", MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        playmoncry(SPECIES_HOOPA, 0)
        waitmoncry
        bosslegendaryencounter(SPECIES_HOOPA, 80, LOCALID_NONE, FLAG_CAUGHT_HOOPA, 3, SPECIES_NONE, 110, BOSS_PHASE_PROFILE_HOOPA)
        if (var(VAR_RESULT) == B_OUTCOME_CAUGHT) {
            msgbox("Something is at the bottom of the
                    now empty contraption.")
            finditem(ITEM_PRISON_BOTTLE)
            release
            end
        } else {
            release
            end
        }
    } else {
        msgbox("Mom did always warn about touching
                strange objects found deep within
                ancient pyramids.")
        release
        end
    }
}