mapscripts VajraPyramidFloor4_MapScripts {}

script Floor4_Ghost1 {
    trainerbattle_single(TRAINER_SPIRIT1, "Woo!", "Woo...")
    msgbox("Woowoo...", MSGBOX_AUTOCLOSE)
}

script Floor4_Ghost2 {
    trainerbattle_single(TRAINER_SPIRIT2, "Give...", "Taken...")
    msgbox("Lost...", MSGBOX_AUTOCLOSE)
}

script Floor4_Ghost3 {
    trainerbattle_single(TRAINER_SPIRIT3, "Do not release it!", "It must be kept imprisoned...")
    msgbox("It shall consume you.", MSGBOX_AUTOCLOSE)
}

script Floor4_Urn1 {
    lock
    if (flag(FLAG_FLOOR4_URN1LOOT)) {
        msgbox("The urn is empty.")
        release
        end
    }
    finditem(ITEM_RELIC_GOLD)
    setflag(FLAG_FLOOR4_URN1LOOT)
    release
    end
}

script Floor4_Urn2 {
    lock
    if (flag(FLAG_FLOOR4_URN2LOOT)) {
        msgbox("The urn is empty.")
        release
        end
    }
    finditem(ITEM_RELIC_GOLD)
    setflag(FLAG_FLOOR4_URN2LOOT)
    release
    end
}