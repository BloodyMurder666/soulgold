mapscripts HiddenGrotto_Route32_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        goto(handleRoute32GrottoEvent)
    }
}

script handleRoute32GrottoEvent {
    special(HiddenGrotto_InitializeCurrent)
    switch (var(VAR_RESULT)) {
        case 2:
            clearflag(FLAG_ROUTE32_GROTTO)
            setobjectxyperm(1, 17, 18)
            setobjectxyperm(2, 8, 4)
        case 3:
            clearflag(FLAG_ROUTE32_GROTTO)
            setobjectxyperm(2, 16, 18)
            setobjectxyperm(1, 8, 4)
        case 4:
            clearflag(FLAG_ROUTE32_GROTTO)
            setobjectxyperm(1, 17, 18)
            setobjectxyperm(2, 16, 18)
        case 1:
            setflag(FLAG_ROUTE32_GROTTO)
            setobjectxyperm(1, 17, 18)
            setobjectxyperm(2, 16, 18)
        case 0:
            clearflag(FLAG_ROUTE32_GROTTO)
            setobjectxyperm(1, 17, 18)
            setobjectxyperm(2, 16, 18)
    }
}

script Route32GrottoApplin {
    lock
    faceplayer
    special(HiddenGrotto_GetCurrentContentId)
    copyvar(VAR_0x8004, VAR_RESULT)
    playmoncry(VAR_0x8004, CRY_MODE_ENCOUNTER)
    special(HiddenGrotto_CreateCurrentMon)
    if (var(VAR_RESULT) == FALSE) {
        release
        end
    }
    waitse
    delay(40)
    waitmoncry
    special(HiddenGrotto_EmptyCurrent)
    setflag(FLAG_ROUTE32_GROTTO)
    dowildbattle
    removeobject(2)
    release
    end
}

script FindItem_Route32Grotto {
    special(HiddenGrotto_GetCurrentContentId)
	finditem(VAR_RESULT)
    special(HiddenGrotto_EmptyCurrent)
    setflag(FLAG_ROUTE32_GROTTO)
	removeobject(1)
    end
}

script FindHiddenItem_Route32Grotto {
    special(HiddenGrotto_GetCurrentContentType)
    if (var(VAR_RESULT) != 4) {
        end
    }

    special(HiddenGrotto_GetCurrentContentId)
    finditem(VAR_RESULT)
    special(HiddenGrotto_EmptyCurrent)
    setflag(FLAG_ROUTE32_GROTTO)
    end
}
