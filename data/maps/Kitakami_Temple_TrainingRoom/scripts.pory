mapscripts Kitakami_Temple_TrainingRoom_MapScripts {}

script dojoFexpert {
    lock
    faceplayer
    msgbox("Training yourself mentally and 
            physically is as important as 
            training your Pokémon. 
            
            Tough challenges cannot be faced 
            with weak body and mind.")
    if (!flag(FLAG_RECEIVED_FOCUS_SASH)) {
        msgbox(format("Perhaps this will help you focus on your training."))
        giveitem(ITEM_FOCUS_SASH)
        setflag(FLAG_RECEIVED_FOCUS_SASH)
    }
    release
    end
}

script dojoTrainer {
    lock
    msgbox("The trainee is meditating, 
            it would be rude to disturb them.")
    closemessage
    release
    end
}

