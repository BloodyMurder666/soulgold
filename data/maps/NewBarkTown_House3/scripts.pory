raw `
NewBarkTown_House3_MapScripts::
    map_script MAP_SCRIPT_ON_TRANSITION, NewBarkTown_House3_OnTransition
	.byte 0

NewBarkTown_House3_OnTransition::
    call Common_EventScript_SetupRivalGfxId
    end
`

script NewBarkTown_RivalsMom {
    lock
    faceplayer
    checkplayergender
    msgbox("Oh, hello {PLAYER}!")
    if (var(VAR_RESULT) == MALE) {
        if (var(VAR_RIVAL_STATE) >= 4 && var(VAR_RIVAL_STATE) < 12) {
            msgbox("Crystal is currently out, if you were
                    looking for her.")
                    release
                    end
        }
        msgbox("Crystal is currently upstairs if
                you are looking for her. She is playing
                with her Pokémon.")
    } else {
        if (var(VAR_RIVAL_STATE) >= 4 && var(VAR_RIVAL_STATE) < 12) {
            msgbox("Gold is currently out, if you were
                    looking for him.")
                    release
                    end
        }
        msgbox("Gold is currently upstairs if
                you are looking for him. He is playing
                with his Pokémon.")
    }
    release
    end
}

script NewBarkTown_RivalsSister {
    lock
    faceplayer
    checkplayergender
    if (var(VAR_RESULT) == MALE) {
        msgbox("Elm gave my sister a Marill, I hope I
                can get a Pokémon to play with 
                soon, too!")
    } else {
        msgbox("Elm gave my brother a Marill, I hope I
                can get a Pokémon to play with 
                soon, too!")
    }  
    release
    end 
    
}

script NewBarkTownRivalHouseRival {
    lock
    faceplayer
    createfieldmugshotrival
    if (var(VAR_RIVAL_STATE) < 12) {
        msgbox("Hey {PLAYER}! Have you visited
            any new places?", MSGBOX_NPC)
        release
        end
    }
    if (var(VAR_RIVAL_STATE) >= 12) {
        if (var(VAR_POSTGAME_RIVAL_LEGENDARYQ) == 0) {
            msgbox("Hey {PLAYER}! What's up?
            
                    So I've been doing some thinking, and
                    decided that I want to help Prof. Elm.
                    with his research into legendary
                    Pokémon!
                    
                    I've started looking into old rumours
                    and stories that are circulating in
                    Johto, and I've found my first lead.
                    
                    If you got time and happen to be in the
                    area, would you mind helping me by
                    checking them out?
                    
                    The first legendary I'm researching
                    right now concerns not one but two
                    Pokémon actually!
                    
                    Have you heard about Darkrai and
                    Cresselia?
                    
                    One causes nightmares while the other
                    cures them, fascinating!
                    
                    I think we should track down Cresselia
                    first, in order to locate Darkrai.
                    
                    I hear that someone living near or in
                    the Lake of Rage might know more.")
                    setvar(VAR_POSTGAME_RIVAL_LEGENDARYQ, 1)
                    release
                    end
        }
        if (var(VAR_POSTGAME_RIVAL_LEGENDARYQ) == 1) {
            msgbox("I hear that someone living near or in
                    the Lake of Rage might know more.")
        }
        if (var(VAR_POSTGAME_RIVAL_LEGENDARYQ) == 2) {
            msgbox("Oh you found Cresselia's location?
            
                    That's great! You should catch it
                    if you're able to!")
        }
        if (var(VAR_POSTGAME_RIVAL_LEGENDARYQ) == 3) {
            msgbox("You caught Cresselia? 
                    Nice!")
        }
    }
    release
    end
    
}

script NewBarkTownRivalHouseMarill {
	lock
    faceplayer
    playmoncry(SPECIES_MARILL, CRY_MODE_NORMAL)
    msgbox("Marii!")
    waitmoncry
    release
    end
}

script NewBarkTownRivalHouseAzumarill {
	lock
    faceplayer
    playmoncry(SPECIES_AZUMARILL, CRY_MODE_NORMAL)
    msgbox("Azumarill: Azuu!")
    waitmoncry
    release
    end
}