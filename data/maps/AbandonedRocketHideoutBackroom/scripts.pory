mapscripts AbandonedRocketHideoutBackroom_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if (flag(FLAG_IS_CHAMPION) && !flag(FLAG_CAUGHT_GENESECT)) {
            clearflag(FLAG_HIDE_GENESECT)
        } else {
            setflag(FLAG_HIDE_GENESECT)
        }
    }
}

script ARH_LaptopBackroom {
    msgbox("While the laptop no longer has power,
            there's a small post-it note under it.
            
            SUBJECT SHADOW L????
            
            The rest of the text has been drenched
            by what seems to be coffee stains.", MSGBOX_NPC)
}

script ARH_NotesBackroom {
    msgbox("Log - Emotion Compression Studies
            
            By crystallizing energy found from a
            certain legendary Pokémon, we have
            managed to create containers for
            holding strong negative emotions. 
            
            These can be used like magnets on
            creatures of high purity to invert
            their emotions to the opposite end.
            
            Further testing will be required to
            see the long term effects.", MSGBOX_SIGN)
}

script ARH_Strangewall {
    msgbox("Something about this wall feels off,
            but there's no visible keyholes or
            card readers.", MSGBOX_SIGN)
}

script GenesectEncounter {
    lock
    faceplayer
    bosslegendaryencounter(SPECIES_GENESECT, 70, LOCALID_GENESECT, FLAG_HIDE_GENESECT, 2, SPECIES_NONE, 110)
    if (var(VAR_RESULT) == B_OUTCOME_CAUGHT) {
        setflag(FLAG_CAUGHT_GENESECT)
    }
    release
    end
}