mapscripts Route40_House5_MapScripts {}

script Route40Cafe_InpatientWoman {
    lock
    faceplayer
    msgbox("Where's my order?! I've been waiting for
            10 minutes already!")
    release
    end
}

script Route40Cafe_Fatman {
    lock
    faceplayer
    msgbox("This cafe has been a hit among the 
            tourists ever since it opened last year.")
    release
    end
}

script Route40Cafe_Rocker {
    lock
    msgbox("I'll have uhh...")
    release
    end
}

script Route40Cafe_Lady {
    lock
    faceplayer
    msgbox("I bought a mint from the lady over
            there and my Pokémon's nature changed!")
    release
    end
}

script Route40Cafe_SellerLady {
    lock
    faceplayer
    msgbox("Welcome! We sell mints for Pokémon!")
    pokemart(CafeCook2)
    msgbox("We hope to see you again!")
    release
    end
}

script Route40Cafe_SellerCook {
    lock
    faceplayer
    msgbox("Welcome, what will you have?")
    pokemart(CafeCook)
    msgbox("Come back soon!")
    release
    end
}

mart CafeCook {
    ITEM_SWEET_APPLE
    ITEM_TART_APPLE
    ITEM_SYRUPY_APPLE
    ITEM_FRESH_WATER
    ITEM_SODA_POP
    ITEM_LEMONADE
    ITEM_SWEET_HEART
    ITEM_PEWTER_CRUNCHIES
    ITEM_LAVA_COOKIE
    ITEM_RAGE_CANDY_BAR
    ITEM_OLD_GATEAU
    ITEM_CASTELIACONE
    ITEM_LUMIOSE_GALETTE
    ITEM_SHALOUR_SABLE
    ITEM_BIG_MALASADA
}

mart CafeCook2 {
    ITEM_ADAMANT_MINT
    ITEM_BOLD_MINT
    ITEM_BRAVE_MINT
    ITEM_CALM_MINT
    ITEM_CAREFUL_MINT
    ITEM_SERIOUS_MINT
    ITEM_GENTLE_MINT
    ITEM_HASTY_MINT
    ITEM_IMPISH_MINT
    ITEM_JOLLY_MINT
    ITEM_LAX_MINT
    ITEM_LONELY_MINT
    ITEM_MILD_MINT
    ITEM_MODEST_MINT
    ITEM_NAIVE_MINT
    ITEM_NAUGHTY_MINT
    ITEM_QUIET_MINT
    ITEM_RASH_MINT
    ITEM_RELAXED_MINT
    ITEM_SASSY_MINT
    ITEM_TIMID_MINT
}