script MeteorCave2_LegeRoom_IronLeaves {
    lock
    faceplayer
    bosslegendaryencounter(SPECIES_IRON_LEAVES, 75, LOCALID_IRONLEAVES, FLAG_HIDE_IRONLEAVES)
    release
    end
}

