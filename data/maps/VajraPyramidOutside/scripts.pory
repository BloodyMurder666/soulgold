mapscripts VajraPyramidOutside_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if (flag(FLAG_IS_CHAMPION) && flag(FLAG_RINTO_TRADE_COMPLETE)) {
            clearflag(FLAG_HIDE_PYRAMIDOUT_SCIENTIST)
        } else {
            setflag(FLAG_HIDE_PYRAMIDOUT_SCIENTIST)
        }
    }
    MAP_SCRIPT_ON_LOAD {
        if (flag(FLAG_IS_CHAMPION) && flag(FLAG_RINTO_TRADE_COMPLETE)) {
            setmetatile(16, 6, 0x4D5, FALSE)
        }
    }
}

script VajraPyramidOutside_Door {
    if (flag(FLAG_IS_CHAMPION) && flag(FLAG_RINTO_TRADE_COMPLETE)) {
        msgbox("The door has been busted open by
                repeated exposure to something
                blunt.", MSGBOX_SIGN)
    } else {
        msgbox("The door is sealed shut tightly.", MSGBOX_SIGN)
    }
}

script VajraPyramidOutside_ScientistPostgame {
    msgbox("We finally managed to break down the
            door to the Pyramid thanks to the
            Tinkaton you gave us!

            Please, feel free to explore it first!", MSGBOX_NPC)
}

script VajraPyramidOutside_ScientistsTinkaton {
    lock
    faceplayer
    playmoncry(SPECIES_TINKATON, 0)
    msgbox("Tinkaton: Tinktii!")
    waitmoncry
    msgbox("Your old Tinkaton seems to be having
            fun here!")
    release
    end
}

script VajraPyramidOutside_RuinManiac {
    msgbox("There's mystery here waiting to be
            uncovered! I can sense it!", MSGBOX_NPC)
}