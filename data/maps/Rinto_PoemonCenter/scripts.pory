mapscripts Rinto_PoemonCenter_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
		setflag(FLAG_TEMP_1)
		setrespawn(HEAL_LOCATION_RINTO_VILLAGE_POKEMON_CENTER)
		end
	}
}

