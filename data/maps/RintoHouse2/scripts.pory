            {STR_VAR_1}'s Defense?", MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        goto(RintoHouse2_BottleCapManiac_ChooseStat)
    }
    removeitem(ITEM_BOTTLE_CAP, 1)
    hypertrain(STAT_DEF, VAR_0x8004)
    goto(RintoHouse2_BottleCapManiac_TrainingDone)
}

