script RintoHouse2_BottleCapManiac_ConfirmSpeed {
    msgbox("Exchange a Bottle Cap to train
            {STR_VAR_1}'s Speed?", MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        goto(RintoHouse2_BottleCapManiac_ChooseStat)
    }
    removeitem(ITEM_BOTTLE_CAP, 1)
    hypertrain(STAT_SPEED, VAR_0x8004)
    goto(RintoHouse2_BottleCapManiac_TrainingDone)
}

script RintoHouse2_BottleCapManiac_TrainingDone {
    msgbox("Then get hyped! It's time for some
            real Hyper Training!")
    closemessage
    fadescreen(FADE_TO_BLACK)
    delay(30)
    playse(SE_EXP_MAX)
    waitse
    fadescreen(FADE_FROM_BLACK)
    msgbox("{STR_VAR_1} grew stronger thanks
            to Hyper Training!

            Want to keep the hype rolling?",
           MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        goto(RintoHouse2_BottleCapManiac_ChooseMon)
    }
    goto(RintoHouse2_BottleCapManiac_Goodbye)
}

script RintoHouse2_BottleCapManiac_Goodbye {
    createfieldmugshot(MUGSHOT_GENTLEMAN)
    msgbox("Come back anytime! I'll always be
            hyped to see you!")
    release
    end
}
