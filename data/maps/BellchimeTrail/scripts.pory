raw `

BellchimeTrail_MapScripts::
	.byte 0


BellchimeTrail_EventScript_Morty::
	lock
	faceplayer
	msgbox BellchimeTrail_Text_Morty, MSGBOX_DEFAULT
	closemessage
	fadescreenswapbuffers FADE_TO_BLACK
	setflag FLAG_HIDE_BELLCHIME_MORTY
	removeobject LOCALID_BELLCHIME_MORTY
	fadescreenswapbuffers FADE_FROM_BLACK
	clearflag FLAG_HIDE_DOJO_MORTY
	release
	end

BellchimeTrail_Text_Morty:
	.string "Morty: The legendary Pokémon\n"
	.string "did not choose me...\p"
	.string "But that does not mean that I\n"
	.string "have lost out on my future.\p"
	.string "I will continue my training until I\n"
	.string "I discover a new future for me.\p"
	.string "If you seek another battle, find\n"
	.string "me at the Fighting Dojo.$"

EcruteakBellchimeTrail_EventScript_DoorTrigger::
	lock
	opendoor 28, 12
	waitdooranim
	addobject OBJ_EVENT_ID_CAMERA
	removeobject OBJ_EVENT_ID_PLAYER
	closedoor 28, 12
	applymovement OBJ_EVENT_ID_CAMERA, EcruteakBellchimeTrail_Movement_CameraPanUp
	waitmovement 0
	warp MAP_TIN_TOWER_1F, 1
	release
	end

EcruteakBellchimeTrail_Movement_CameraPanUp::
	slide_up
	slide_up
	slide_up
	slide_up
	slide_up
	slide_up
	slide_up
	step_end
`

script BellchimeTrail_MortyRematch {
    lock
    faceplayer
	msgbox("Morty: In the end, the Legendary
			Pokémon did not choose me.
			
			I wonder the reason often when I walk
			this trail.
			
			I would like to confirm their reason by
			battling you again if that is
			acceptable to you, {PLAYER}.", MSGBOX_YESNO)
	if (var(VAR_RESULT) == TRUE) {
		msgbox("Thank you, I will you those watching
				to be as worthy as you!")
		trainerbattle_no_intro(TRAINER_MORTY_2, "I see now why they chose you.")
		msgbox("Merely being strong or wise is not
				enough always. It takes also something
				more intangible that you posses. I hope
				the spirits continue to bless you.
				
				Until our next meeting.")
		closemessage
		fadescreenswapbuffers(FADE_TO_BLACK)
		setflag(FLAG_HIDE_BELLCHIME_MORTY)
		removeobject(LOCALID_BELLCHIME_MORTY)
		delay(30)
		fadescreenswapbuffers(FADE_FROM_BLACK)
	}
    release
    end
}