mapscripts HiddenGrotto_Ilex_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        goto(handleILEXGrottoEvent)
    }
}

script handleILEXGrottoEvent {
    special(HiddenGrotto_InitializeCurrent)
    switch (var(VAR_RESULT)) {
        case 0:
            clearflag(FLAG_ILEX_GROTTO) //HIDDEN_GROTTO_UNSET, should never land on this anyway
            setobjectxyperm(1, 28, 27)
            setobjectxyperm(2, 28, 27)
            setobjectxyperm(LOCALID_GROTTO_HIDDEN_ITEM_ILEX, 28, 27)
        case 1:
            setflag(FLAG_ILEX_GROTTO) // HIDDEN_GROTTO_EMPTY
            setobjectxyperm(1, 28, 27)
            setobjectxyperm(2, 28, 27)
            setobjectxyperm(LOCALID_GROTTO_HIDDEN_ITEM_ILEX, 28, 27)
        case 2:
            clearflag(FLAG_ILEX_GROTTO) //HIDDEN_GROTTO_POKEMON
            setobjectxyperm(1, 28, 27)
            setobjectxyperm(2, 14, 11)
            setobjectxyperm(LOCALID_GROTTO_HIDDEN_ITEM_ILEX, 28, 27)
        case 3:
            clearflag(FLAG_ILEX_GROTTO) //HIDDEN_GROTTO_ITEM
            setobjectxyperm(2, 28, 27)
            setobjectxyperm(1, 14, 11)
            setobjectxyperm(LOCALID_GROTTO_HIDDEN_ITEM_ILEX, 28, 27)
        case 4:
            clearflag(FLAG_ILEX_GROTTO) //HIDDEN_GROTTO_HIDDEN_ITEM
            setobjectxyperm(LOCALID_GROTTO_ITEM_ILEX, 28, 27)
            setobjectxyperm(LOCALID_GROTTO_POKEMON_ILEX, 28, 27)
            setobjectxyperm(LOCALID_GROTTO_HIDDEN_ITEM_ILEX, 14, 11)

    }
}

script ILEX_GrottoPokemon {
    lock
    faceplayer
    special(HiddenGrotto_GetCurrentContentId)
    copyvar(VAR_0x8004, VAR_RESULT)
    playmoncry(VAR_0x8004, CRY_MODE_ENCOUNTER)
    special(HiddenGrotto_CreateCurrentMon)
    if (var(VAR_RESULT) == FALSE) {
        release
        end
    }
    waitse
    delay(40)
    waitmoncry
    special(HiddenGrotto_EmptyCurrent)
    setflag(FLAG_ILEX_GROTTO)
    dowildbattle
    removeobject(2)
    release
    end
}

script FindItem_ILEX_Grotto {
    special(HiddenGrotto_GetCurrentContentId)
	finditem(VAR_RESULT)
    if (var(VAR_0x8007) == FALSE) {
        end
    }
    special(HiddenGrotto_EmptyCurrent)
    setflag(FLAG_ILEX_GROTTO)
	removeobject(1)
    end
}

script FindHiddenItem_ILEX_Grotto {
    special(HiddenGrotto_GetCurrentContentType)
    if (var(VAR_RESULT) != 4) {
        end
    }

    special(HiddenGrotto_GetCurrentContentId)
    finditem(VAR_RESULT)
    if (var(VAR_0x8007) == FALSE) {
        end
    }
    special(HiddenGrotto_EmptyCurrent)
    setflag(FLAG_ILEX_GROTTO)
    end
}
