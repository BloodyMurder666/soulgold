script MeteorCave1_LegeRoom_RagingBolt {
    lock
    faceplayer
    legendaryencounter(SPECIES_RAGING_BOLT, 75, LOCALID_RAGINGBOLT, FLAG_HIDE_RAGINGBOLT)
    release
    end
}

