mapscripts MtSilver_1F_RegigigasRoom_MapScripts {}

script MtSilver_Regigigas {
    lock
    checkspecies(SPECIES_REGISTEEL)
    if (var(VAR_RESULT) == TRUE) {
        checkspecies(SPECIES_REGIROCK)
        if (var(VAR_RESULT) == TRUE) {
            checkspecies(SPECIES_REGICE)
            if (var(VAR_RESULT) == TRUE) {
                msgbox("...!
                
                        The statue suddenly started moving
                        in reaction to your Pokémon!
                        
                        The statue attacked!")
                bosslegendaryencounter(SPECIES_REGIGIGAS, 70, LOCALID_MTSILVER_REGIGIGAS, FLAG_HIDE_REGIGIGAS, 4, SPECIES_NONE, 110)
                release
                end
            } else {
                goto(RegigigasSlumbers)
            }
        } else {
            goto(RegigigasSlumbers)
        }
    } else {
        goto(RegigigasSlumbers)
    }
    release
    end

}

script RegigigasSlumbers {
    msgbox("A large, almost statue-like Pokémon
            seems to be resting here.
             
            ...
            
            It does not react to your presence.")
    release
    end
}
